{
    "name": "expense-splitter",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@11.17.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "generate:api": "openapi-typescript ../expense-splitter-api/openapi.json -o src/lib/api/generated/schema.ts && prettier --write src/lib/api/generated/schema.ts",
        "postbuild": "cp dist/index.html dist/404.html",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm test:coverage"
    },
    "dependencies": {
        "@fontsource-variable/ibm-plex-sans": "^5.3.0",
        "@hookform/resolvers": "^5.5.7",
        "@radix-ui/react-accordion": "^1.2.20",
        "@radix-ui/react-alert-dialog": "^1.1.23",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-popover": "^1.1.23",
        "@tanstack/react-query": "^5.101.4",
        "axios": "^1.19.0",
        "clsx": "^2.1.1",
        "lucide-react": "^1.32.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-hook-form": "^7.86.0",
        "react-router": "^8.3.0",
        "recharts": "^3.10.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.5",
        "globals": "^17.8.0",
        "jsdom": "^29.1.1",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.10"
    }
}
